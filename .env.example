# Example environment variables for frontend (do NOT commit real secrets)

# API base URL (point to your Render backend)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# NextAuth secret (if using NextAuth)
NEXTAUTH_SECRET=your_nextauth_secret_here

# Any other public keys used by frontend
NEXT_PUBLIC_SOME_FEATURE_KEY=...
#config authjs
AUTH_SECRET=
NEXT_PUBLIC_BACKEND_URL=localhost:8081